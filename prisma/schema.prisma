// The Plug Africa database (PostgreSQL).
// Local development: Docker (docker-compose.yml, port 5433). Staging/production: Supabase (London).
// Change the schema with `npm run db:migrate -- --name <change>`; commit the generated migration.
// Status fields are strings validated in src/lib/status.ts (kept from the SQLite version).

generator client {
  // No custom `output`: OpenNext patches the default client for Cloudflare Workers (issue #4).
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection used by the app
  directUrl = env("DIRECT_URL") // direct connection used by migrations
}

// Team accounts (issue #18). Roles and what each may do: src/lib/roles.ts.
model Admin {
  dealsRecorded ConciergeDeal[]
  id            String             @id @default(cuid())
  email         String             @unique
  name          String
  passwordHash  String
  role          String             @default("editor") // owner | editor | viewer (existing accounts became owners)
  // Sessions signed before this moment stop working (set when the password changes).
  sessionsSince DateTime           @default(now())
  lastSignInAt  DateTime?
  createdAt     DateTime           @default(now())
  invitesSent   Invite[]           @relation("InvitedBy")
  activity      AuditLog[]
  assigned      ConciergeRequest[]
}

// A single-use link to join the team (purpose "invite") or set a new password ("reset"). Only a hash is stored.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  purpose     String    @default("invite") // invite | reset
  email       String
  name        String
  role        String
  invitedById String?
  invitedBy   Admin?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Who changed what in the admin. The actor's name is copied so entries survive the account being removed.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName  String
  action     String // e.g. business.update, team.invite (src/lib/audit.ts)
  summary    String
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String // CatKey from src/lib/directory.ts
  kind        String // e.g. "Furnished apartment"
  city        String
  area        String
  blurb       String
  about       String
  price       String   @default("Price on request")
  responds    String   @default("Usually replies within a day")
  languages   String   @default("English") // comma-separated
  images      String   @default("[]") // JSON array of image paths
  // Contact details are only shown after the disclaimer, with a reference code
  phone       String?
  whatsapp    String?
  email       String?
  status      String   @default("draft") // draft | in_review | verified | hidden
  isExample   Boolean  @default(false) // design placeholder, not a real business
  rating      Float?
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials       Credential[]
  enquiries         Enquiry[]
  reviews           Review[]
  conciergeRequests ConciergeRequest[]
  services          Service[] // one or more services within its category (issue #26)
  savedBy           SavedBusiness[]
  deals             ConciergeDeal[]
  oldSlugs          SlugAlias[]

  @@index([status, category, city])
}

model Credential {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  state      String   @default("pending") // pending | in_review | verified
  note       String?
  position   Int      @default(0)
}

/// A service (sub-category) inside a category, e.g. Rentals → Cars. Managed by the admin (issue #26).
model Service {
  id          String     @id @default(cuid())
  category    String // CatKey from src/lib/directory.ts
  slug        String // unique within its category; used in /explore/<category>/<slug>
  name        String
  description String     @default("")
  image       String     @default("")
  position    Int        @default(0)
  visible     Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businesses  Business[]

  @@unique([category, slug])
  @@index([category, visible, position])
}

/// Every "Contact this business" creates one: the reference code proves the lead came from The Plug.
model Enquiry {
  id            String    @id @default(cuid())
  ref           String    @unique
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // contact = the visitor asked for contact details; request = they sent a request through The Plug (issue #50)
  kind          String    @default("contact")
  name          String?
  phone         String?
  email         String?
  city          String?
  message       String?
  // Where and when (issue #50)
  serviceMode   String? // my_place | their_place | elsewhere | remote
  area          String?
  landmark      String? // landmark or Ghana Post GPS address
  meetingPlace  String? // where to meet or be picked up, when serviceMode = elsewhere
  preferredDate String? // YYYY-MM-DD
  timeOfDay     String?
  status        String    @default("new") // new | contacted | converted | closed
  notes         String?
  // A salted hash of the visitor (never their IP): asking again for the same business within a day returns the same
  // reference instead of a new one, so review codes can't be minted in bulk (issue #94).
  visitorHash   String?
  // The visitor's account when they were signed in (issue #82); kept as a plain request if the account is deleted.
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([businessId, visitorHash, createdAt])
}

model ConciergeRequest {
  id            String          @id @default(cuid())
  ref           String          @unique
  name          String
  phone         String
  email         String?
  city          String
  category      String
  service       String? // service name when sent from a service page, e.g. "Licence acquisition" (issue #36)
  details       String
  timing        String
  // Where and when (issue #50)
  serviceMode   String? // my_place | their_place | elsewhere | remote
  area          String?
  landmark      String? // landmark or Ghana Post GPS address
  meetingPlace  String? // where to meet or be picked up, when serviceMode = elsewhere
  preferredDate String? // YYYY-MM-DD
  timeOfDay     String?
  businessId    String?
  business      Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status        String          @default("new") // new | in_progress | done | closed
  notes         String?
  // Team member handling it (issue #67); cleared if their account is removed.
  assignedToId  String?
  assignedTo    Admin?          @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  // The visitor's account when they were signed in (issue #82).
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Sent by a concierge member (issue #83): marked in the admin, and new ones are listed first.
  fromMember    Boolean         @default(false)
  deals         ConciergeDeal[]
  createdAt     DateTime        @default(now())

  @@index([assignedToId])
  @@index([userId])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  ref          String   @unique
  businessName String
  category     String
  city         String
  name         String
  phone        String
  email        String?
  status       String   @default("new") // new | contacted | onboarded | declined
  notes        String?
  createdAt    DateTime @default(now())
}

/// General messages from the Contact page (issue #29).
model ContactMessage {
  id        String   @id @default(cuid())
  ref       String   @unique
  name      String
  email     String?
  phone     String?
  topic     String
  message   String
  status    String   @default("new") // new | replied | closed
  notes     String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Shared counters for rate limits (issue #7): admin sign-in attempts and public form submissions.
/// Keys hold a one-way hash of the visitor's IP, never the IP itself.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Emergency numbers (issue #11). Shown on /emergency only once verified, with their source and date.
model EmergencyContact {
  id         String    @id @default(cuid())
  country    String    @default("Ghana")
  city       String? // null = the whole country (e.g. 112)
  service    String // ambulance | police | fire | hospital | embassy | pharmacy | other (src/lib/emergency.ts)
  name       String // e.g. "National Ambulance Service", "Korle Bu Teaching Hospital"
  phone      String
  altPhone   String?
  address    String?
  notes      String? // e.g. "24 hours", "Emergency unit at the main gate"
  source     String? // where the number was confirmed, e.g. "Called on 3 Nov" or the official website
  sourceUrl  String?
  verifiedAt DateTime? // null = not verified, so not public
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([country, city])
}

// Customer reviews (issue #14). Tied to a reference code from contacting the business through The Plug, one review per
// code, and shown only after the team approves them. Businesses can't edit or delete reviews.
model Review {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ref         String    @unique // the PLG- or CNC- reference that proves the contact
  name        String // shown with the review
  rating      Int // 1 to 5
  body        String
  status      String    @default("pending") // pending | approved | rejected
  response    String? // public reply from The Plug
  respondedAt DateTime?
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([businessId, status])
  @@index([status, createdAt])
}

/// A visitor's own account (issue #82). Signing in is by a code sent to the email: there is no password.
model User {
  id            String    @id @default(cuid())
  email         String    @unique // stored lower-case
  name          String?
  phone         String?
  createdAt     DateTime  @default(now())
  lastSignInAt  DateTime?
  // Sessions signed before this time are refused ("sign out everywhere", account deletion).
  sessionsSince DateTime  @default(now())

  saved             SavedBusiness[]
  enquiries         Enquiry[]
  conciergeRequests ConciergeRequest[]
  membership        Membership?
}

/// A one-time sign-in code (issue #82). Only a hash is stored; a code works once, for 10 minutes, with 5 tries.
model SignInCode {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

/// A business a visitor saved with the heart (issue #82).
model SavedBusiness {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
  @@index([businessId])
}

/// Concierge membership (issue #83): a Paystack subscription. Paystack is the source of truth; its webhook keeps
/// this row in step. A member keeps the benefits until `currentPeriodEnd`, even after cancelling.
model Membership {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String    @default("pending") // pending | active | non_renewing | past_due | cancelled
  planCode         String?
  subscriptionCode String?   @unique
  emailToken       String? // Paystack's token for cancelling this subscription
  customerCode     String?
  currentPeriodEnd DateTime? // next payment date while active; the end of access once cancelled
  startedAt        DateTime?
  cancelledAt      DateTime?
  lastEvent        String? // the last Paystack event applied, for troubleshooting
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

/// A deal the concierge closed between a customer and a business (issue #84). The Plug's fee is a share of the agreed
/// value from each side; the deal itself is paid directly between them, never through The Plug.
model ConciergeDeal {
  id           String           @id @default(cuid())
  requestId    String
  // Kept while fees exist: a request with a recorded deal can't be deleted.
  request      ConciergeRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  businessId   String?
  business     Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  businessName String // as it was when recorded; the business may not be listed
  description  String
  valuePesewas Int // the agreed price of the deal, in pesewas (GHS)
  // Rates in basis points (1000 = 10%), stored so later changes to the rates don't alter old deals.
  customerRate Int
  businessRate Int
  recordedById String?
  recordedBy   Admin?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  fees         ConciergeFee[]

  @@index([requestId])
  @@index([createdAt])
}

/// One side's fee on a deal (issue #84), paid through a Paystack link the site emails.
model ConciergeFee {
  id            String        @id @default(cuid())
  ref           String        @unique // FEE-XXXX-XXXX, shown to people
  token         String        @unique // the unguessable part of the /pay/<token> link
  dealId        String
  deal          ConciergeDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  party         String // customer | business
  name          String
  email         String?
  phone         String?
  amountPesewas Int
  status        String        @default("due") // due | paid | waived | cancelled
  paidVia       String? // paystack | offline
  paystackRef   String? // the Paystack transaction that paid it
  sentAt        DateTime?
  paidAt        DateTime?
  note          String?
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
}

/// A business's previous web address (issue #94): /listing/<old> redirects to the current one, so shared links keep
/// working after a rename.
model SlugAlias {
  slug       String   @id
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// A photo on the site that the admin has changed (issue #112): the home hero, category headers, page headers. Only
/// changed slots have a row; the rest show the built-in photo (src/lib/site-images.ts lists every slot).
model SiteImage {
  key       String   @id
  url       String
  alt       String   @default("")
  caption   String   @default("")
  updatedAt DateTime @updatedAt
}
