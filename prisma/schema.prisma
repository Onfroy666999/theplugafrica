// The Plug Africa database (PostgreSQL).
// Local development: Docker (docker-compose.yml, port 5433). Staging/production: Supabase (London).
// Change the schema with `npm run db:migrate -- --name <change>`; commit the generated migration.
// Status fields are strings validated in src/lib/status.ts (kept from the SQLite version).

generator client {
  // No custom `output`: OpenNext patches the default client for Cloudflare Workers (issue #4).
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection used by the app
  directUrl = env("DIRECT_URL") // direct connection used by migrations
}

// Team accounts (issue #18). Roles and what each may do: src/lib/roles.ts.
model Admin {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  role          String     @default("editor") // owner | editor | viewer (existing accounts became owners)
  // Sessions signed before this moment stop working (set when the password changes).
  sessionsSince DateTime   @default(now())
  lastSignInAt  DateTime?
  createdAt     DateTime   @default(now())
  invitesSent   Invite[]   @relation("InvitedBy")
  activity      AuditLog[]
  assigned      ConciergeRequest[]
}

// A single-use link to join the team (purpose "invite") or set a new password ("reset"). Only a hash is stored.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  purpose     String    @default("invite") // invite | reset
  email       String
  name        String
  role        String
  invitedById String?
  invitedBy   Admin?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Who changed what in the admin. The actor's name is copied so entries survive the account being removed.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  actorName  String
  action     String // e.g. business.update, team.invite (src/lib/audit.ts)
  summary    String
  targetType String?
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String // CatKey from src/lib/directory.ts
  kind        String // e.g. "Furnished apartment"
  city        String
  area        String
  blurb       String
  about       String
  price       String   @default("Price on request")
  responds    String   @default("Usually replies within a day")
  languages   String   @default("English") // comma-separated
  images      String   @default("[]") // JSON array of image paths
  // Contact details are only shown after the disclaimer, with a reference code
  phone       String?
  whatsapp    String?
  email       String?
  status      String   @default("draft") // draft | in_review | verified | hidden
  isExample   Boolean  @default(false) // design placeholder, not a real business
  rating      Float?
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  credentials       Credential[]
  enquiries         Enquiry[]
  conciergeRequests ConciergeRequest[]
  services          Service[] // one or more services within its category (issue #26)

  @@index([status, category, city])
}

model Credential {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label      String
  state      String   @default("pending") // pending | in_review | verified
  note       String?
  position   Int      @default(0)
}

/// A service (sub-category) inside a category, e.g. Rentals → Cars. Managed by the admin (issue #26).
model Service {
  id          String     @id @default(cuid())
  category    String // CatKey from src/lib/directory.ts
  slug        String // unique within its category; used in /explore/<category>/<slug>
  name        String
  description String     @default("")
  image       String     @default("")
  position    Int        @default(0)
  visible     Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businesses  Business[]

  @@unique([category, slug])
  @@index([category, visible, position])
}

/// Every "Contact this business" creates one: the reference code proves the lead came from The Plug.
model Enquiry {
  id            String    @id @default(cuid())
  ref           String    @unique
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  // contact = the visitor asked for contact details; request = they sent a request through The Plug (issue #50)
  kind          String    @default("contact")
  name          String?
  phone         String?
  email         String?
  city          String?
  message       String?
  // Where and when (issue #50)
  serviceMode   String? // my_place | their_place | elsewhere | remote
  area          String?
  landmark      String? // landmark or Ghana Post GPS address
  meetingPlace  String? // where to meet or be picked up, when serviceMode = elsewhere
  preferredDate String? // YYYY-MM-DD
  timeOfDay     String?
  status        String    @default("new") // new | contacted | converted | closed
  notes         String?
  createdAt     DateTime  @default(now())
}

model ConciergeRequest {
  id            String    @id @default(cuid())
  ref           String    @unique
  name          String
  phone         String
  email         String?
  city          String
  category      String
  service       String? // service name when sent from a service page, e.g. "Licence acquisition" (issue #36)
  details       String
  timing        String
  // Where and when (issue #50)
  serviceMode   String? // my_place | their_place | elsewhere | remote
  area          String?
  landmark      String? // landmark or Ghana Post GPS address
  meetingPlace  String? // where to meet or be picked up, when serviceMode = elsewhere
  preferredDate String? // YYYY-MM-DD
  timeOfDay     String?
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  status        String    @default("new") // new | in_progress | done | closed
  notes         String?
  // Team member handling it (issue #67); cleared if their account is removed.
  assignedToId  String?
  assignedTo    Admin?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([assignedToId])
}

model WaitlistEntry {
  id           String   @id @default(cuid())
  ref          String   @unique
  businessName String
  category     String
  city         String
  name         String
  phone        String
  email        String?
  status       String   @default("new") // new | contacted | onboarded | declined
  notes        String?
  createdAt    DateTime @default(now())
}

/// General messages from the Contact page (issue #29).
model ContactMessage {
  id        String   @id @default(cuid())
  ref       String   @unique
  name      String
  email     String?
  phone     String?
  topic     String
  message   String
  status    String   @default("new") // new | replied | closed
  notes     String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Shared counters for rate limits (issue #7): admin sign-in attempts and public form submissions.
/// Keys hold a one-way hash of the visitor's IP, never the IP itself.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Emergency numbers (issue #11). Shown on /emergency only once verified, with their source and date.
model EmergencyContact {
  id         String    @id @default(cuid())
  country    String    @default("Ghana")
  city       String? // null = the whole country (e.g. 112)
  service    String // ambulance | police | fire | hospital | embassy | pharmacy | other (src/lib/emergency.ts)
  name       String // e.g. "National Ambulance Service", "Korle Bu Teaching Hospital"
  phone      String
  altPhone   String?
  address    String?
  notes      String? // e.g. "24 hours", "Emergency unit at the main gate"
  source     String? // where the number was confirmed, e.g. "Called on 3 Nov" or the official website
  sourceUrl  String?
  verifiedAt DateTime? // null = not verified, so not public
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([country, city])
}
