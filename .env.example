# Copy to .env and fill in. Never commit .env.
# Local: start the database with `npm run db:up` (Docker). Hosted (Supabase): DATABASE_URL = the pooled
# connection (port 6543, add ?pgbouncer=true); DIRECT_URL = the direct connection (port 5432).
DATABASE_URL="postgresql://plug:plug_local_dev@127.0.0.1:5433/theplugafrica"
DIRECT_URL="postgresql://plug:plug_local_dev@127.0.0.1:5433/theplugafrica"
# Long random string used to sign admin sessions
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_NAME=""
# Starting password for the admin account (change it with: npm run admin:password)
ADMIN_PASSWORD=""

# Public address of the site, used for the sitemap, canonical links and share previews.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
